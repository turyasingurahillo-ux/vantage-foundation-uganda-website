    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "exifreader": "4.42.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5",
