# Public site URL used for canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.vantagefoundationuganda.com

# ---------------------------------------------------------------------------
# Contact routing and email privacy
# ---------------------------------------------------------------------------
# Vantage's operational Gmail account is a PROTECTED mailbox. It is never
# published on the website: it is not in content/site.ts, not in JSON-LD, and
# not in any client bundle. It is resolved server-side only, in
# lib/contact-inbox.ts. Do not add it to any NEXT_PUBLIC_* variable — those are
# inlined into the browser bundle.
#
# NEXT_PUBLIC_CONTACT_EMAIL: the public alias to DISPLAY on the site (footer,
# policy pages, JSON-LD). Leave BLANK until the alias has actually been created
# and verified in Cloudflare Email Routing and a test message has arrived. While
# blank, the site shows a "Contact Vantage" link to the contact form instead of
# an address, so it can never advertise a non-working mailbox. Consumer-provider
# addresses (gmail.com, outlook.com, …) are rejected by design.
NEXT_PUBLIC_CONTACT_EMAIL=

# CONTACT_INBOX: where contact-form notifications are delivered (server-only).
# Defaults to Vantage's protected mailbox if unset, so delivery keeps working.
CONTACT_INBOX=

# Optional per-category destinations (server-only). Set these once the matching
# aliases exist; any left blank fall back to CONTACT_INBOX.
CONTACT_INBOX_PARTNERSHIPS=
CONTACT_INBOX_GRANTS=
CONTACT_INBOX_MEDIA=
CONTACT_INBOX_RESEARCH=
CONTACT_INBOX_SAFEGUARDING=

# Cloudflare Turnstile bot challenge (optional). The form enforces Turnstile
# only when BOTH variables are set; until then it relies on its honeypots,
# time-trap, rate limiting and server-side validation. The SECRET key must
# never be prefixed NEXT_PUBLIC_ — that would ship it to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional SMTP config for form notifications.
# If SMTP_HOST is set, all form submissions (contact, newsletter, donor) are
# emailed to the site's contact address. If unset, forms still validate and
# return success but no email is sent (the user is told to email directly).
#
# SMTP_FROM is the "From" address for outgoing emails. Many SMTP providers
# (Gmail, Outlook, SendGrid, etc.) require this to match the authenticated
# SMTP_USER or a verified sender domain. If left blank, the site's contact
# email is used as the From address, which may be rejected by strict SPF/DMARC
# policies. Set SMTP_FROM to an address authorized by your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Neon PostgreSQL connection string (server-side only, never commit a real value)
DATABASE_URL=

# Admin dashboard secret key (server-side only)
ADMIN_SECRET=

# Cloudflare R2 object storage (server-only) — the SAME bucket and
# credentials already used by the sibling kikumikyo project. Do not create a
# new bucket or rename these variables; copy the existing values from that
# project's Vercel settings into this project's Vercel settings (Vercel env
# vars are per-project, not shared automatically). Vantage's own objects live
# under a vantage/ prefix within the shared bucket, so nothing here can
# collide with kikumikyo's own academy/ or organizations/ prefixes.
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=replace-with-existing-bucket-name

# Instagram Graph API (server-only) — required for the "Popular on Instagram"
# homepage section. The Instagram account must be a Business or Creator
# account linked to a Facebook Page. See docs/instagram-integration.md for
# setup instructions.
#
# INSTAGRAM_ACCESS_TOKEN: A long-lived access token from the Meta Graph API.
# INSTAGRAM_BUSINESS_ACCOUNT_ID: The numeric IG Business Account ID.
# INSTAGRAM_USERNAME: The Instagram username (without @).
# INSTAGRAM_PROFILE_URL: The full profile URL (defaults to site.socials.instagram).
#
# CRON_SECRET: Optional secret to protect the /api/instagram/refresh endpoint.
# If set, cron requests must include "Authorization: Bearer <CRON_SECRET>".
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_USERNAME=vantagefoundationuganda
INSTAGRAM_PROFILE_URL=https://www.instagram.com/vantagefoundationuganda/
CRON_SECRET=
